GEMINI_PROXY_KEY=replace-with-your-proxy-key
GEMINI_PROXY_BASE_URL=https://ai4a11y.lovable.app/api/public/gemini/v1beta
GEMINI_MODEL=gemini-4-argon
# Used by Compose for the HTTPS entry point. Set this to the host LAN IP for phones.
APP_HOST=localhost
HTTPS_PORT=8443
BIND_ADDRESS=127.0.0.1
# Used only with compose.codeserver.yaml. Keep the path and forwarded port aligned.
CODE_SERVER_BASE_PATH=/proxy/8443
CODE_SERVER_PORT=8443
